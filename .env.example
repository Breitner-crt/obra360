# Copiar a .env y completar (nunca commitear el .env real)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
APP_NAME=OBRA360
APP_ENV=development
# POOLER (obligatorio en Vercel y en redes sin IPv6):
# Supabase > Settings > Database > Transaction pooler (puerto 6543).
# Acepta ?pgbouncer=true, el backend lo limpia solo.
DATABASE_POOLER_URL=postgresql://postgres.tu-ref:tu-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Directa 5432 solo como fallback local con IPv6 (suele dar
# "Cannot assign requested address" en Windows/Vercel).
DATABASE_URL=postgresql://postgres:postgres@db.tu-proyecto.supabase.co:5432/postgres
